node_modules
dist
coverage
.turbo
*.log

# Remotion render output + dynamically downloaded cover images
packages/video-renderer/out
packages/video-renderer/public/covers

# Local SQLite databases and rendered episodes — the main DB file is the one
# exception: GitHub Actions has no persistent disk between runs, so it's the
# committed state store for anti-repeat/cooldown history (see
# .github/workflows/daily-pipeline.yml).
*.sqlite-shm
*.sqlite-wal
*.sqlite3
/data/*
!/data/blindtest.sqlite

# Secrets / credentials — never commit these
.env
.env.*
!.env.example
**/client_secret*.json
**/*-oauth-token.json

.DS_Store

# Local dev tool config (bakes in machine-specific paths, e.g. this Node install)
.claude/launch.json
