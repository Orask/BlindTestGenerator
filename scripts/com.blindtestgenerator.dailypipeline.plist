<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.blindtestgenerator.dailypipeline</string>

    <!-- Paths below are specific to this Mac — adjust if installing elsewhere. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/lucaslordon/Documents/GitHub/BlindTestGenerator/scripts/run-daily-pipeline.sh</string>
    </array>

    <!-- Fires once a day. If the Mac is asleep at this time, launchd runs
         the missed job as soon as the Mac wakes and the user is logged in —
         but not if the Mac was fully powered off. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/lucaslordon/Documents/GitHub/BlindTestGenerator/data/logs/launchd-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/lucaslordon/Documents/GitHub/BlindTestGenerator/data/logs/launchd-stderr.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
