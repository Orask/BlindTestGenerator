# Copy this file to .env (already gitignored) and fill in the real values.
# Never commit .env or paste its contents in chat.

# Spotify Developer Dashboard → your app → Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional — one or more extra Spotify developer apps (each with its own
# client_id/secret from a separate app in the Developer Dashboard) that the
# pipeline fails over to when the primary app above gets rate-limited or
# runs out of request budget, instead of stalling the whole run. Numbered
# from _2 (SPOTIFY_CLIENT_ID_2/SPOTIFY_CLIENT_SECRET_2, then _3, etc.) —
# stop numbering once you have as many apps as you want; leave all of these
# empty to keep the previous single-app behavior exactly as before. See
# packages/integrations/spotify/src/rotating-client.ts.
SPOTIFY_CLIENT_ID_2=
SPOTIFY_CLIENT_SECRET_2=
SPOTIFY_CLIENT_ID_3=
SPOTIFY_CLIENT_SECRET_3=

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Desktop app)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Filled in automatically by the one-time authorization script (see below),
# not something you type in by hand.
YOUTUBE_REFRESH_TOKEN=

# Optional — console.anthropic.com → API Keys. Leave empty to skip the AI
# episode review step (apps/pipeline/src/review-episode.ts); the pipeline
# works exactly as before without it.
ANTHROPIC_API_KEY=
